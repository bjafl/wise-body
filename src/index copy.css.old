@import "tailwindcss";

@theme inline {
  --color-background: oklch(0.98 0.005 85);
  --color-foreground: oklch(0.25 0.02 50);
  --color-card: oklch(1 0 0);
  --color-card-foreground: oklch(0.25 0.02 50);
  --color-popover: oklch(1 0 0);
  --color-popover-foreground: oklch(0.25 0.02 50);
  --color-primary: oklch(0.55 0.12 165);
  --color-primary-foreground: oklch(0.98 0.005 85);
  --color-secondary: oklch(0.94 0.02 85);
  --color-secondary-foreground: oklch(0.35 0.03 50);
  --color-muted: oklch(0.94 0.01 85);
  --color-muted-foreground: oklch(0.55 0.02 50);
  --color-accent: oklch(0.92 0.03 85);
  --color-accent-foreground: oklch(0.25 0.02 50);
  --color-destructive: oklch(0.55 0.2 25);
  --color-destructive-foreground: oklch(0.98 0.005 85);
  --color-border: oklch(0.90 0.01 85);
  --color-input: oklch(0.90 0.01 85);
  --color-ring: oklch(0.55 0.12 165);

  --color-energy-full: oklch(0.65 0.18 155);
  --color-energy-good: oklch(0.70 0.15 145);
  --color-energy-medium: oklch(0.75 0.12 85);
  --color-energy-low: oklch(0.65 0.15 50);
  --color-energy-empty: oklch(0.55 0.18 25);

  --radius: 0.625rem;
  --font-sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
}
