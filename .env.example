# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wisebody
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wisebody
# If using the compose-defined postgres service, host must be "postgres"
DATABASE_URL=postgresql://wisebody:change-me@postgres:5432/wisebody

# ── API ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-use-openssl-rand-base64-64
JWT_EXPIRES_IN=7d
# Generate with: openssl rand -base64 64
COOKIE_SECRET=change-me-use-openssl-rand-base64-64
# Mobile app origin — no trailing slash
CORS_ORIGIN=https://app.your-domain.com
# Admin panel origin — no trailing slash
ADMIN_CORS_ORIGIN=https://admin.your-domain.com
LOG_LEVEL=info

# ── Admin panel credentials (runtime — set in Coolify, never commit) ─────────
# These are checked server-side; never baked into any Docker image.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Ports (optional — defaults shown) ────────────────────────────────────────
API_PORT=3000
WEB_PORT=80
ADMIN_PORT=8080
# POSTGRES_PORT: only used by docker-compose.override.yml (local dev).
# postgres is not exposed to the host in production.
POSTGRES_PORT=5432

# ── Build args (baked into the JS bundles at Docker build time) ───────────────
VITE_API_URL=https://api.your-domain.com
